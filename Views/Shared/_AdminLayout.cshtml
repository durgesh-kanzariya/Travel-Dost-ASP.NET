<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelDost Admin</title>
    <!-- Use site.css compiled by Tailwind v4. Do NOT use CDN. -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        // Check for dark mode preference
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="bg-slate-50 dark:bg-slate-950 font-sans transition-colors duration-300">
    <!-- Removed React wrapper, keeping structure -->
    <div class="min-h-screen bg-slate-50 dark:bg-slate-950 transition-colors duration-300">
        <!-- Mobile Header -->
        <div class="lg:hidden flex items-center justify-between bg-white dark:bg-slate-900 p-4 shadow-sm border-b border-slate-100 dark:border-slate-800">
            <span class="text-xl font-bold text-red-600 dark:text-red-500">TravelDost Admin</span>
            <button id="mobile-sidebar-toggle" class="text-slate-600 dark:text-slate-300">
                <i data-lucide="menu" class="h-6 w-6" id="menu-icon-open"></i>
                <i data-lucide="x" class="h-6 w-6 hidden" id="menu-icon-close"></i>
            </button>
        </div>

        <div class="flex min-h-screen">
            <!-- Sidebar -->
            <aside id="sidebar" class="fixed inset-y-0 left-0 z-[50] w-64 transform bg-white dark:bg-slate-900 shadow-lg dark:shadow-slate-900/50 transition-transform duration-200 ease-in-out lg:sticky lg:top-0 lg:h-screen lg:translate-x-0 -translate-x-full">
                <div class="flex h-full flex-col">
                    <div class="flex h-16 items-center px-4 border-b border-slate-100 dark:border-slate-800">
                        <a asp-controller="Admin" asp-action="Dashboard" class="flex items-center gap-2">
                            <img src="~/logo.jpeg" alt="TravelDost Logo" class="w-8 h-8 object-cover rounded-md flex-shrink-0" />
                            <span class="text-lg font-bold text-sky-600 dark:text-sky-400 truncate">TravelDost</span>
                            <span class="shrink-0 text-xs bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400 px-1.5 py-0.5 rounded font-bold">ADMIN</span>
                        </a>
                    </div>

                    <!-- Navigation Links -->
                    @{
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
                    }
                    <nav class="flex-1 space-y-1 px-3 py-4 overflow-y-auto">
                        <a asp-controller="Admin" asp-action="Dashboard" 
                           class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors @(currentAction == "dashboard" ? "bg-sky-50 text-sky-600 dark:bg-sky-900/20 dark:text-sky-400" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-200")">
                            <i data-lucide="layout-dashboard" class="h-5 w-5 @(currentAction == "dashboard" ? "text-sky-600 dark:text-sky-400" : "text-slate-400 dark:text-slate-500")"></i>
                            Dashboard
                        </a>
                        <a asp-controller="Admin" asp-action="Users" 
                           class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors @(currentAction == "users" ? "bg-sky-50 text-sky-600 dark:bg-sky-900/20 dark:text-sky-400" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-200")">
                            <i data-lucide="users" class="h-5 w-5 @(currentAction == "users" ? "text-sky-600 dark:text-sky-400" : "text-slate-400 dark:text-slate-500")"></i>
                            Manage Users
                        </a>
                        <a asp-controller="Admin" asp-action="Guides" 
                           class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors @(currentAction == "guides" ? "bg-sky-50 text-sky-600 dark:bg-sky-900/20 dark:text-sky-400" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-200")">
                            <i data-lucide="shield-alert" class="h-5 w-5 @(currentAction == "guides" ? "text-sky-600 dark:text-sky-400" : "text-slate-400 dark:text-slate-500")"></i>
                            Manage Guides
                        </a>
                    </nav>

                    <!-- User Profile Section -->
                    <div class="border-t border-slate-200 dark:border-slate-800 p-4">
                        <div class="flex items-center gap-3 mb-4">
                            @{
                                var userJson = Context.Session.GetString("user");
                                var firstName = "System";
                                var lastName = "Admin";
                                var email = "admin@traveldost.mobi";
                                
                                if (!string.IsNullOrEmpty(userJson))
                                {
                                    try {
                                        var userData = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(userJson);
                                        firstName = userData.TryGetProperty("firstName", out var fn) ? fn.GetString() : "System";
                                        lastName = userData.TryGetProperty("lastName", out var ln) ? ln.GetString() : "Admin";
                                        email = userData.TryGetProperty("email", out var e) ? e.GetString() : "admin@traveldost.mobi";
                                    } catch { }
                                }
                            }
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-red-100 dark:bg-red-900/30">
                                <i data-lucide="user" class="h-6 w-6 text-red-600 dark:text-red-400"></i>
                            </div>
                            <div class="flex-1 overflow-hidden">
                                <p class="truncate text-sm font-medium text-slate-900 dark:text-white">
                                    @firstName @lastName
                                </p>
                                <p class="truncate text-xs text-slate-500 dark:text-slate-400">
                                    @email
                                </p>
                            </div>
                        </div>

                        <button id="theme-toggle-btn" class="flex w-full items-center gap-2 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors mb-2">
                            <i data-lucide="moon" class="h-5 w-5 dark:hidden"></i>
                            <i data-lucide="sun" class="h-5 w-5 hidden dark:block"></i>
                            <span class="dark:hidden">Dark Mode</span>
                            <span class="hidden dark:inline">Light Mode</span>
                        </button>

                        <a asp-controller="Home" asp-action="Dashboard" class="flex w-full items-center gap-2 rounded-lg px-2 py-2 text-sm font-medium text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-900/20 transition-colors mb-2">
                            <i data-lucide="arrow-left-right" class="h-5 w-5"></i>
                            Switch to User View
                        </a>

                        <a asp-controller="Auth" asp-action="Logout" class="flex w-full items-center gap-2 rounded-lg px-2 py-2 text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                            <i data-lucide="log-out" class="h-5 w-5"></i>
                            Sign Out
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1 w-full min-w-0 overflow-x-hidden p-4 lg:p-8">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Mobile sidebar overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden backdrop-blur-sm"></div>

    <script>
        lucide.createIcons();

        // Theme toggle logic
        const themeBtn = document.getElementById('theme-toggle-btn');
        if(themeBtn) {
            themeBtn.addEventListener('click', () => {
                const isDark = document.documentElement.classList.toggle('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
            });
        }

        // Mobile Sidebar toggle logic
        const mobileToggle = document.getElementById('mobile-sidebar-toggle');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');

        function toggleSidebar() {
            const isOpen = !sidebar.classList.contains('-translate-x-full');
            if (isOpen) {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
                iconOpen.classList.remove('hidden');
                iconClose.classList.add('hidden');
            } else {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                iconOpen.classList.add('hidden');
                iconClose.classList.remove('hidden');
            }
        }

        if(mobileToggle) mobileToggle.addEventListener('click', toggleSidebar);
        if(overlay) overlay.addEventListener('click', toggleSidebar);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
