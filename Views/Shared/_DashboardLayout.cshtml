@using System.Text.Json
@{
    var userJson = Context.Session.GetString("user");
    var user = !string.IsNullOrEmpty(userJson) ? JsonSerializer.Deserialize<JsonElement>(userJson) : default;
    var firstName = user.ValueKind != JsonValueKind.Undefined ? user.GetProperty("firstName").GetString() : "Traveler";
    var lastName = user.ValueKind != JsonValueKind.Undefined ? user.GetProperty("lastName").GetString() : "";
    var email = user.ValueKind != JsonValueKind.Undefined ? user.GetProperty("email").GetString() : "user@example.com";
    var role = user.ValueKind != JsonValueKind.Undefined && user.TryGetProperty("role", out var r) ? r.GetString() : "user";
    
    var currentPath = Context.Request.Path.ToString().ToLower();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelDost</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="bg-slate-50 dark:bg-slate-950 font-sans transition-colors duration-300">
    <div class="min-h-screen">
        <!-- Mobile Header -->
        <div class="lg:hidden flex items-center justify-between bg-white dark:bg-slate-900 p-4 shadow-sm border-b border-slate-100 dark:border-slate-800">
            <span class="text-xl font-bold text-sky-600">TravelDost</span>
            <button id="mobile-menu-btn" class="text-slate-600 dark:text-slate-400">
                <i data-lucide="menu" class="h-6 w-6"></i>
            </button>
        </div>

        <div class="flex">
            <!-- Sidebar -->
            <aside id="sidebar" class="fixed inset-y-0 left-0 z-[100] w-64 transform bg-white dark:bg-slate-900 shadow-lg dark:shadow-slate-900/50 transition-transform duration-200 ease-in-out lg:sticky lg:top-0 lg:h-screen lg:translate-x-0 -translate-x-full">
                <div class="flex h-full flex-col">
                    <div class="flex shrink-0 h-16 items-center px-6 border-b border-slate-100 dark:border-slate-800">
                        <a asp-controller="Home" asp-action="Dashboard" class="flex items-center gap-2">
                            <img src="/logo.jpeg" alt="TravelDost Logo" class="w-10 h-10 object-cover rounded-md" />
                            <span class="text-2xl font-bold text-sky-600 dark:text-sky-500">TravelDost</span>
                        </a>
                    </div>

                    <nav class="flex-1 space-y-1 px-3 py-4 overflow-y-auto">
                        @{
                            var menuItems = new[] {
                                new { Label = "Dashboard", Icon = "layout-dashboard", Action = "Dashboard", Controller = "Home" },
                                new { Label = "My Trips", Icon = "plane", Action = "Index", Controller = "Trips" },
                                new { Label = "Expenses", Icon = "dollar-sign", Action = "Index", Controller = "Expenses" },
                                new { Label = "Trip Checklist", Icon = "check-square", Action = "Index", Controller = "Checklist" },
                                new { Label = "Translator", Icon = "globe", Action = "Index", Controller = "Translator" },
                                new { Label = "Currency", Icon = "banknote", Action = "Index", Controller = "CurrencyConverter" },
                                new { Label = "Emergency", Icon = "phone", Action = "Index", Controller = "Emergency" },
                                new { Label = "Settings", Icon = "settings", Action = "Index", Controller = "Settings" }
                            };
                        }

                        @foreach (var item in menuItems)
                        {
                            var isActive = currentPath.Contains(item.Controller.ToLower());
                            <a href="/@item.Controller/@item.Action" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors @(isActive ? "bg-sky-50 text-sky-600 dark:bg-sky-900/20 dark:text-sky-400" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-200")">
                                <i data-lucide="@item.Icon" class="h-5 w-5 @(isActive ? "text-sky-600 dark:text-sky-400" : "text-slate-400 dark:text-slate-500")"></i>
                                @item.Label
                            </a>
                        }
                    </nav>

                    <!-- Profile Section -->
                    <div class="border-t border-slate-200 dark:border-slate-800 p-4">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-sky-100 dark:bg-sky-900/30">
                                <i data-lucide="user" class="h-6 w-6 text-sky-600 dark:text-sky-400"></i>
                            </div>
                            <div class="flex-1 overflow-hidden">
                                <p class="truncate text-sm font-bold text-slate-900 dark:text-white">@firstName @lastName</p>
                                <p class="truncate text-xs text-slate-500 dark:text-slate-400">@email</p>
                            </div>
                        </div>

                        <button id="theme-toggle" class="flex w-full items-center gap-2 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors mb-2">
                            <i data-lucide="sun" class="h-5 w-5 dark:hidden"></i>
                            <i data-lucide="moon" class="h-5 w-5 hidden dark:block"></i>
                            <span class="dark:hidden">Dark Mode</span>
                            <span class="hidden dark:block">Light Mode</span>
                        </button>

                        @if (role == "admin")
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="flex w-full items-center gap-2 rounded-lg px-2 py-2 text-sm font-medium text-purple-600 dark:text-purple-400 hover:bg-purple-50 dark:hover:bg-purple-900/20 transition-colors mb-2">
                                <i data-lucide="arrow-left-right" class="h-5 w-5"></i>
                                Admin View
                            </a>
                        }

                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button type="submit" class="flex w-full items-center gap-2 rounded-lg px-2 py-2 text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors">
                                <i data-lucide="log-out" class="h-5 w-5"></i>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1 w-full min-w-0 overflow-x-hidden p-4 lg:p-8">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        lucide.createIcons();

        // Theme Toggle
        document.getElementById('theme-toggle').addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });

        // Mobile Menu Toggle
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn.addEventListener('click', () => {
            sidebar.classList.toggle('-translate-x-full');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
