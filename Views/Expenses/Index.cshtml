@using travel_dost_asp.net.Models
@model List<Expense>
@{
    ViewData["Title"] = "Expense Tracker";
    Layout = "_DashboardLayout";
    var trips = ViewBag.Trips as List<Trip> ?? new List<Trip>();
    var selectedTrip = ViewBag.SelectedTrip as Trip;
    var totalSpent = (decimal)(ViewBag.TotalSpent ?? 0m);
    var budget = (decimal)(ViewBag.Budget ?? 0m);
    var progress = budget > 0 ? (int)Math.Min((double)totalSpent / (double)budget * 100, 100) : 0;
    var isOverBudget = totalSpent > budget && budget > 0;
}

<div class="mb-8">
    <div class="mb-8">
        <nav class="flex mb-2" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                <li><a asp-controller="Home" asp-action="Dashboard" class="hover:text-sky-600 transition-colors">Dashboard</a></li>
                <li><i data-lucide="chevron-right" class="h-3 w-3"></i></li>
                <li class="text-slate-900 dark:text-white">Expenses</li>
            </ol>
        </nav>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-2">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl flex items-center gap-3">
                    <i data-lucide="wallet" class="h-8 w-8 text-sky-600 dark:text-sky-400"></i>
                    Expense Tracker
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-400">Track spending for each trip</p>
            </div>

            <div class="flex items-center gap-3">
                <select id="trip-selector" onchange="location.href='?trip_id=' + this.value" 
                        class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-medium focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none">
                    @foreach (var trip in trips)
                    {
                        var destName = string.IsNullOrEmpty(trip.Destination) ? "Unnamed Trip" : trip.Destination.Replace("|", " → ");
                        if (selectedTrip?.TripId == trip.TripId)
                        {
                            <option value="@trip.TripId" selected>@destName (@trip.StartDate.ToShortDateString())</option>
                        }
                        else
                        {
                            <option value="@trip.TripId">@destName (@trip.StartDate.ToShortDateString())</option>
                        }
                    }
                </select>
                <button onclick="document.getElementById('add-expense-modal').classList.remove('hidden')" class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white rounded-xl font-medium transition-colors">
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    Add Expense
                </button>
            </div>
        </div>
    </div>

    @if (selectedTrip != null)
    {
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm">
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">Total Spent</p>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">@selectedTrip.Currency @totalSpent.ToString("N2")</p>
            </div>
            <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm">
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">Budget</p>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">@selectedTrip.Currency @budget.ToString("N2")</p>
            </div>
            <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-sm text-slate-500 dark:text-slate-400">Budget Used</p>
                    <span class="text-sm font-bold @(isOverBudget ? "text-red-500" : "text-sky-500")">@progress%</span>
                </div>
                <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800">
                    <div class="h-2 rounded-full @(isOverBudget ? "bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.5)]" : "bg-sky-500") transition-all" style="width: @progress%"></div>
                </div>
                @if (isOverBudget)
                {
                    <p class="mt-2 text-xs text-red-500 font-medium flex items-center gap-1">
                        <i data-lucide="alert-triangle" class="h-3 w-3"></i> Over budget by @selectedTrip.Currency @((totalSpent - budget).ToString("N2"))
                    </p>
                }
            </div>
        </div>

        <!-- Expense List -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700">
            <div class="p-5 border-b border-slate-100 dark:border-slate-800">
                <h2 class="font-semibold text-slate-900 dark:text-white">All Expenses</h2>
            </div>
            
            @if (!Model.Any())
            {
                <div class="p-12 text-center">
                    <i data-lucide="alert-circle" class="h-10 w-10 text-slate-300 dark:text-slate-600 mx-auto mb-3"></i>
                    <p class="text-slate-500 dark:text-slate-400">No expenses yet for this trip.</p>
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var exp in Model)
                    {
                        var categoryColor = exp.Category switch
                        {
                            "Food" => "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
                            "Transport" => "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400",
                            "Hotel" => "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400",
                            "Activities" => "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400",
                            "Shopping" => "bg-pink-100 text-pink-700 dark:bg-pink-900/30 dark:text-pink-400",
                            "Health" => "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400",
                            _ => "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300"
                        };

                        <div id="exp-@exp.Id" class="flex items-center justify-between p-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <div class="flex items-center gap-4">
                                <span class="px-2.5 py-1 rounded-lg text-xs font-medium @categoryColor">
                                    @exp.Category
                                </span>
                                <div>
                                    <p class="text-sm font-medium text-slate-900 dark:text-white">@(string.IsNullOrEmpty(exp.Description) ? "No description" : exp.Description)</p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">@exp.ExpenseDate.ToString("yyyy-MM-dd")</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                <div class="text-right">
                                    <p class="font-semibold text-slate-900 dark:text-white">
                                        @exp.Currency @exp.Amount.ToString("N2")
                                    </p>
                                    @if (ViewBag.NormalizedAmounts != null)
                                    {
                                        var dict = ViewBag.NormalizedAmounts as Dictionary<int, decimal>;
                                        if (dict != null && dict.TryGetValue(exp.Id, out var nAmt))
                                        {
                                            <p class="text-[13px] text-slate-400 dark:text-slate-500 font-medium">
                                                ≈ @selectedTrip.Currency @nAmt.ToString("N2")
                                            </p>
                                        }
                                    }
                                </div>
                                <button onclick="deleteExpense(@exp.Id)" class="text-slate-400 hover:text-red-500 transition-colors p-1">
                                    <i data-lucide="trash-2" class="h-4 w-4"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 p-12 text-center">
            <i data-lucide="briefcase" class="h-16 w-16 mx-auto mb-4 text-slate-300 opacity-50"></i>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">No Trips Found</h3>
            <p class="text-slate-500 mt-2">Create a trip first to start tracking expenses.</p>
            <a asp-controller="Trips" asp-action="Index" class="mt-6 inline-flex items-center gap-2 px-6 py-3 bg-sky-600 text-white rounded-xl font-bold hover:bg-sky-700 transition-all">
                Go to Trips
                <i data-lucide="arrow-right" class="h-4 w-4"></i>
            </a>
        </div>
    }
</div>
<!-- Add Expense Modal -->
<div id="add-expense-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm">
    <div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl shadow-2xl overflow-hidden border border-slate-200 dark:border-slate-800">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50 dark:bg-slate-800/50">
            <h2 class="font-bold text-slate-900 dark:text-white">Add New Expense</h2>
            <button onclick="document.getElementById('add-expense-modal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i data-lucide="x" class="h-5 w-5"></i></button>
        </div>
        <form asp-action="Add" method="post" class="p-6 space-y-4">
            <input type="hidden" name="tripId" value="@selectedTrip?.TripId" />
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Amount *</label>
                    <input type="number" step="0.01" name="amount" required class="w-full px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none" placeholder="0.00" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Currency</label>
                    <select name="currency" id="expense-currency" onchange="checkCurrencyWarning('@selectedTrip?.Currency')" class="w-full px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none">
                        @{
                            var currencies = new[] { "USD", "EUR", "GBP", "INR", "JPY", "AUD", "CAD" };
                            foreach (var c in currencies)
                            {
                                if (c == (selectedTrip?.Currency ?? "USD"))
                                {
                                    <option value="@c" selected>@c</option>
                                }
                                else
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        }
                    </select>
                    <p id="currency-warning" class="hidden mt-1 text-xs text-amber-500">⚠ Trip budget is in @selectedTrip?.Currency. This expense will be stored as <span id="warn-curr"></span>.</p>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Category</label>
                <select name="category" required class="w-full px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none">
                    <option value="Food">Food</option>
                    <option value="Transport">Transport</option>
                    <option value="Hotel">Hotel</option>
                    <option value="Activities">Activities</option>
                    <option value="Shopping">Shopping</option>
                    <option value="Health">Health</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Description</label>
                <input type="text" name="description" required class="w-full px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none" placeholder="e.g., Dinner at restaurant" />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Date</label>
                <input type="date" name="expenseDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" required class="w-full px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 outline-none" />
            </div>
            
            <button type="submit" class="w-full py-3 bg-sky-600 hover:bg-sky-700 text-white rounded-xl font-medium transition-colors">Add Expense</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        async function deleteExpense(id) {
            if (!confirm('Delete this expense?')) return;
            try {
                const res = await fetch(`/Expenses/Delete?id=${id}`, { method: 'POST' });
                if (res.ok) {
                    document.getElementById(`exp-${id}`).remove();
                    location.reload();
                }
            } catch (e) {
                alert('Failed to delete expense.');
            }
        }
    </script>
}
