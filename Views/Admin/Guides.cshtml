@model List<travel_dost_asp.net.Models.CountryGuide>
@{
    ViewData["Title"] = "Country Guides Management";
    Layout = "_AdminLayout";
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl">
            Manage Country Guides
        </h1>
        <p class="mt-2 text-slate-600 dark:text-slate-400">
            Create and update travel guides for different countries.
        </p>
    </div>

    <button onclick="document.getElementById('add-guide-modal').classList.remove('hidden')" 
            class="flex items-center justify-center gap-2 bg-sky-600 text-white px-4 py-2 rounded-lg hover:bg-sky-700 transition-colors shadow-sm font-medium">
        <i data-lucide="plus" class="w-5 h-5"></i>
        Add New Guide
    </button>
</div>

<!-- Search Bar -->
<div class="mb-6 relative">
    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400"></i>
    <input type="text"
           id="guide-search-input"
           placeholder="Search countries..."
           class="w-full sm:w-64 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 pl-10 pr-4 py-2 text-sm text-slate-900 dark:text-white focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
</div>

<!-- Guides Grid -->
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="guides-grid">
    @if (Model == null || !Model.Any())
    {
        <p class="text-slate-500 dark:text-slate-400 col-span-full">No guides found.</p>
    }
    else
    {
        @foreach (var guide in Model)
        {
            <div id="guide-@guide.Id" class="guide-card bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm hover:shadow-md transition-shadow" data-search="@guide.CountryName">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-3 w-full">
                        <div class="h-10 w-10 flex-shrink-0 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center">
                            <i data-lucide="map-pin" class="h-5 w-5 text-sky-600 dark:text-sky-400"></i>
                        </div>
                        <h3 class="font-bold text-lg text-slate-900 dark:text-white truncate">
                            @guide.CountryName
                        </h3>
                    </div>
                    <div class="flex gap-2 flex-shrink-0">
                        <button onclick="deleteGuide(@guide.Id)" class="p-2 text-slate-500 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors" title="Delete Guide">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <div class="space-y-2 text-sm text-slate-600 dark:text-slate-300">
                    <p><span class="font-medium text-slate-900 dark:text-slate-200">Police:</span> @guide.PoliceNumber</p>
                    <p><span class="font-medium text-slate-900 dark:text-slate-200">Ambulance:</span> @guide.AmbulanceNumber</p>
                    <p><span class="font-medium text-slate-900 dark:text-slate-200">Fire:</span> @guide.FireNumber</p>
                </div>
            </div>
        }
    }
</div>

<!-- Add Guide Modal (React Matching DOM constraints) -->
<div id="add-guide-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm">
    <div class="w-full max-w-lg bg-white dark:bg-slate-900 rounded-2xl shadow-xl overflow-hidden border border-slate-200 dark:border-slate-800">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50 dark:bg-slate-800/50">
            <h2 class="font-bold text-lg text-slate-900 dark:text-white">Add Country Guide</h2>
            <button onclick="document.getElementById('add-guide-modal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 p-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>
        <form asp-action="AddGuide" method="post" class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Country Name</label>
                <input type="text" name="countryName" required class="w-full p-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none transition-shadow" placeholder="e.g. France" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Police</label>
                    <input type="text" name="policeNumber" class="w-full p-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none transition-shadow" placeholder="112" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Ambulance</label>
                    <input type="text" name="ambulanceNumber" class="w-full p-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none transition-shadow" placeholder="112" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Fire</label>
                    <input type="text" name="fireNumber" class="w-full p-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none transition-shadow" placeholder="112" />
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Embassy Number (Optional)</label>
                <input type="text" name="embassyNumber" class="w-full p-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none transition-shadow" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Local Rules (One per line)</label>
                <textarea name="localRules" rows="3" class="w-full p-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none transition-shadow resize-none"></textarea>
            </div>
            <div class="pt-2 flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('add-guide-modal').classList.add('hidden')" class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-lg transition-colors border border-transparent">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-sky-600 hover:bg-sky-700 rounded-lg transition-colors shadow-sm">
                    Save Guide
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Client-side search filtering
        document.getElementById('guide-search-input').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            const cards = document.querySelectorAll('.guide-card');
            
            cards.forEach(card => {
                const searchData = card.getAttribute('data-search').toLowerCase();
                if (searchData.includes(term)) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });

        async function deleteGuide(id) {
            if (!confirm('Are you sure you want to delete this country guide?')) return;
            try {
                const res = await fetch(`/Admin/DeleteGuide/${id}`, { method: 'POST' });
                if (res.ok) {
                    document.getElementById(`guide-${id}`).remove();
                } else {
                    alert('Failed to delete guide.');
                }
            } catch (e) {
                alert('An error occurred.');
            }
        }
    </script>
}
