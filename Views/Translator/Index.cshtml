@{
    ViewData["Title"] = "Smart Translator";
    Layout = "_DashboardLayout";

    var userJson = Context.Session.GetString("user");
    var user = userJson != null ? System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(userJson) : default;
    var nativeLang = user.GetRawText() != null ? user.GetProperty("nativeLanguage").GetString() : "English";

    var languages = new[] {
        new { Code = "en", Name = "English" },
        new { Code = "hi", Name = "Hindi" },
        new { Code = "gu", Name = "Gujarati" },
        new { Code = "es", Name = "Spanish" },
        new { Code = "fr", Name = "French" },
        new { Code = "de", Name = "German" },
        new { Code = "zh", Name = "Chinese (Simplified)" },
        new { Code = "ja", Name = "Japanese" },
        new { Code = "ru", Name = "Russian" },
        new { Code = "ar", Name = "Arabic" },
        new { Code = "ko", Name = "Korean" },
        new { Code = "it", Name = "Italian" }
    };

    var defaultTargetLang = languages.FirstOrDefault(l => l.Code != "en" && l.Name != nativeLang)?.Code ?? "hi";
}

<div class="max-w-7xl mx-auto">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <nav class="flex mb-2" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                    <li><a asp-controller="Home" asp-action="Dashboard" class="hover:text-sky-600 transition-colors">Dashboard</a></li>
                    <li><i data-lucide="chevron-right" class="h-3 w-3"></i></li>
                    <li class="text-slate-900 dark:text-white">Translator</li>
                </ol>
            </nav>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl flex items-center gap-3 mt-2">
                <i data-lucide="languages" class="h-8 w-8 text-sky-600 dark:text-sky-400"></i>
                Translator
            </h1>
            <p id="location-status" class="mt-2 text-slate-600 dark:text-slate-400">Translate text instantly.</p>
        </div>
        <button id="refresh-location-btn" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors disabled:opacity-50 shrink-0">
            <i id="refresh-icon" data-lucide="refresh-cw" class="h-4 w-4"></i>
            Refresh Location
        </button>
    </div>

    <div class="max-w-4xl mx-auto space-y-6">
        <div class="grid grid-cols-[1fr,auto,1fr] gap-4 items-center bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
            <select id="lang-from" class="p-2 rounded-lg border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white outline-none focus:border-sky-500 transition-colors">
                @foreach (var lang in languages)
                {
                    <option value="@lang.Code" selected="@(lang.Name == nativeLang)">@lang.Name</option>
                }
            </select>
            <button id="swap-langs" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <i data-lucide="arrow-right-left" class="h-5 w-5 text-slate-500"></i>
            </button>
            <select id="lang-to" class="p-2 rounded-lg border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-sky-300 outline-none focus:border-sky-500 transition-colors">
                @foreach (var lang in languages)
                {
                    <option value="@lang.Code" selected="@(lang.Code == defaultTargetLang)">@lang.Name</option>
                }
            </select>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
            <div class="relative">
                <textarea id="text-input" placeholder="Type here..." class="w-full h-48 p-4 text-lg rounded-2xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800/60 outline-none resize-none text-slate-900 dark:text-white focus:border-sky-400 transition-colors"></textarea>
                <button id="clear-input" class="hidden absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">✕</button>
            </div>

            <div class="relative bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 h-48 p-4 flex flex-col justify-between">
                <div id="translating-indicator" class="hidden flex items-center justify-center h-full text-sky-600 gap-2">
                    <i data-lucide="refresh-cw" class="h-6 w-6 animate-spin"></i>
                    Translating...
                </div>

                <div id="output-container" class="flex flex-col h-full justify-between">
                    <p class="text-xl font-medium text-slate-800 dark:text-slate-100 overflow-y-auto w-full">
                        <span id="output-text" class="hidden"></span>
                        <span id="output-placeholder" class="text-slate-400 italic">Translation will appear here...</span>
                    </p>
                    <div id="output-actions" class="hidden flex justify-end pt-2 border-t border-slate-200/50 mt-2">
                        <button id="speak-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/80 dark:bg-slate-700/50 text-sm font-medium hover:text-sky-700 transition-all shadow-sm">
                            <i data-lucide="volume-2" class="h-4 w-4"></i>
                            Pronounce
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <button id="translate-btn" disabled class="w-full py-4 bg-sky-600 hover:bg-sky-700 disabled:opacity-50 text-white text-lg font-bold rounded-xl shadow-lg transition-all">
            Translate Text
        </button>

        <div class="mt-8 pt-8 border-t border-slate-200/50 dark:border-slate-700/50">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <i data-lucide="star" class="h-5 w-5 text-amber-400 fill-amber-400"></i>
                Quick Phrases
            </h3>
            <div id="quick-phrases-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                <!-- Javascript will inject phrases here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const quickPhrases = [
          { id: 1, text: 'Hello', category: 'Greetings', translations: { es: 'Hola', fr: 'Bonjour', de: 'Hallo', ja: 'こんにちは', zh: '你好', ar: 'مرحبا', hi: 'नमस्ते', ru: 'Привет', pt: 'Olá', th: 'สวัสดี' } },
          { id: 2, text: 'Thank you', category: 'Greetings', translations: { es: 'Gracias', fr: 'Merci', de: 'Danke', ja: 'ありがとう', zh: '谢谢', ar: 'شكرا', hi: 'धन्यवाद', ru: 'Спасибо', pt: 'Obrigado', th: 'ขอบคุณ' } },
          { id: 3, text: 'Where is the hospital?', category: 'Emergency', translations: { es: '¿Dónde está el hospital?', fr: 'Où est l\'hôpital?', de: 'Wo ist das Krankenhaus?', ja: '病院はどこですか？', zh: '医院在哪里', ar: 'أين المستشفى؟', hi: 'अस्पताल कहाँ है?', ru: 'Где больница?', pt: 'Onde fica o hospital?', th: 'โรงพยาบาลอยู่ที่ไหน?' } },
          { id: 4, text: 'I need help', category: 'Emergency', translations: { es: 'Necesito ayuda', fr: 'J\'ai besoin d\'aide', de: 'Ich brauche Hilfe', ja: '助けて', zh: '我需要帮助', ar: 'أحتاج للمساعدة', hi: 'मुझे मदद चाहिए', ru: 'Мне нужна помощь', pt: 'Preciso de ajuda', th: 'ฉันต้องการความช่วยเหลือ' } },
          { id: 5, text: 'How much is this?', category: 'Shopping', translations: { es: '¿Cuánto cuesta esto?', fr: 'Combien ça coûte?', de: 'Wie viel kostet das?', ja: 'これはいくらですか', zh: '这个多少钱', ar: 'كم سعر هذا؟', hi: 'यह कितने का है?', ru: 'Сколько это стоит?', pt: 'Quanto custa isso?', th: 'นี่ราคาเท่าไหร่?' } },
          { id: 6, text: 'Water please', category: 'Food', translations: { es: 'Agua por favor', fr: 'De l\'eau s\'il vous plaît', de: 'Wasser bitte', ja: '水をください', zh: '请给我水', ar: 'ماء من فضلك', hi: 'पानी दीजिए', ru: 'Вода пожалуйста', pt: 'Água por favor', th: 'น้ำหน่อยครับ' } },
          { id: 7, text: 'Goodbye', category: 'Greetings', translations: { es: 'Adiós', fr: 'Au revoir', de: 'Auf Wiedersehen', ja: 'さようなら', zh: '再见', ar: 'مع السلامة', hi: 'अलविदा', ru: 'До свидания', pt: 'Adeus', th: 'ลาก่อน' } },
          { id: 8, text: 'Please', category: 'Greetings', translations: { es: 'Por favor', fr: 'S\'il vous plaît', de: 'Bitte', ja: 'お願いします', zh: '请', ar: 'من فضلك', hi: 'कृपया', ru: 'Пожалуйста', pt: 'Por favor', th: 'กรุณา' } },
          { id: 9, text: 'Yes', category: 'Greetings', translations: { es: 'Sí', fr: 'Oui', de: 'Ja', ja: 'はい', zh: '是', ar: 'نعم', hi: 'हाँ', ru: 'Да', pt: 'Sim', th: 'ใช่' } },
          { id: 10, text: 'No', category: 'Greetings', translations: { es: 'No', fr: 'Non', de: 'Nein', ja: 'いいえ', zh: '不', ar: 'لا', hi: 'नहीं', ru: 'Нет', pt: 'Não', th: 'ไม่' } },
          { id: 11, text: 'I don\'t understand', category: 'Emergency', translations: { es: 'No entiendo', fr: 'Je ne comprends pas', de: 'Ich verstehe nicht', ja: 'わかりません', zh: '我不明白', ar: 'لا أفهم', hi: 'मुझे समझ नहीं आया', ru: 'Я не понимаю', pt: 'Não entendo', th: 'ฉันไม่เข้าใจ' } },
          { id: 12, text: 'Call the police', category: 'Emergency', translations: { es: 'Llame a la policía', fr: 'Appelez la police', de: 'Rufen Sie die Polizei', ja: '警察を呼んでください', zh: '请报警', ar: 'اتصل بالشرطة', hi: 'पुलिस को बुलाओ', ru: 'Вызовите полицию', pt: 'Chame a polícia', th: 'เรียกตำรวจ' } },
        ];

        const textInput = document.getElementById('text-input');
        const outputText = document.getElementById('output-text');
        const outputPlaceholder = document.getElementById('output-placeholder');
        const outputActions = document.getElementById('output-actions');
        const translatingIndicator = document.getElementById('translating-indicator');
        const outputContainer = document.getElementById('output-container');
        const translateBtn = document.getElementById('translate-btn');
        const clearBtn = document.getElementById('clear-input');

        const langFrom = document.getElementById('lang-from');
        const langTo = document.getElementById('lang-to');

        // Location Detection
        function fetchLocation() {
            const btn = document.getElementById('refresh-location-btn');
            const icon = document.getElementById('refresh-icon');
            const status = document.getElementById('location-status');

            btn.disabled = true;
            icon.classList.add('animate-spin');

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(async (pos) => {
                    try {
                        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${pos.coords.latitude}&lon=${pos.coords.longitude}`);
                        const data = await res.json();
                        const country = data.address.country || 'Unknown';
                        status.innerText = `Detected location: ${country}. Translating to local language.`;

                        // Map country to naive language if possible, else skip.
                    } catch (e) {
                        status.innerText = 'Translate text instantly.';
                    } finally {
                        btn.disabled = false;
                        icon.classList.remove('animate-spin');
                    }
                }, () => {
                    status.innerText = 'Location access denied.';
                    btn.disabled = false;
                    icon.classList.remove('animate-spin');
                });
            }
        }

        document.getElementById('refresh-location-btn').onclick = fetchLocation;

        textInput.addEventListener('input', () => {
            translateBtn.disabled = textInput.value.trim().length === 0;
            clearBtn.classList.toggle('hidden', textInput.value.trim().length === 0);
        });

        clearBtn.onclick = () => {
            textInput.value = '';
            translateBtn.disabled = true;
            clearBtn.classList.add('hidden');
        };

        async function handleTranslate() {
            const text = textInput.value.trim();
            if (!text) return;

            translateBtn.disabled = true;
            outputContainer.classList.add('hidden');
            translatingIndicator.classList.remove('hidden');

            try {
                const response = await fetch(`/api/translate?text=${encodeURIComponent(text)}&from=${langFrom.value}&to=${langTo.value}`);
                const data = await response.json();

                if (data.translatedText) {
                    outputText.innerText = data.translatedText;
                    outputText.classList.remove('hidden');
                    outputPlaceholder.classList.add('hidden');
                    outputActions.classList.remove('hidden');
                } else {
                    throw new Error('Empty response');
                }
            } catch (error) {
                alert('Translation failed. Please try again.');
                outputPlaceholder.classList.remove('hidden');
            } finally {
                translatingIndicator.classList.add('hidden');
                outputContainer.classList.remove('hidden');
                translateBtn.disabled = false;
            }
        }

        translateBtn.onclick = handleTranslate;

        document.getElementById('swap-langs').onclick = () => {
            const temp = langFrom.value;
            langFrom.value = langTo.value;
            langTo.value = temp;
        };

        document.getElementById('speak-btn').onclick = () => {
            if (outputText.innerText) {
                const utterance = new SpeechSynthesisUtterance(outputText.innerText);
                utterance.lang = langTo.value;
                window.speechSynthesis.speak(utterance);
            }
        };

        function renderQuickPhrases() {
            const container = document.getElementById('quick-phrases-container');
            container.innerHTML = quickPhrases.map(phrase => `
                <button onclick="setQuickPhrase('${phrase.text.replace(/'/g, "\\'")}', '${phrase.id}')" class="text-left px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800/40 hover:bg-sky-50 dark:hover:bg-sky-900/20 hover:border-sky-200 dark:hover:border-sky-800 transition-all group shadow-sm">
                  <span class="block text-xs font-semibold text-slate-400 dark:text-slate-500 group-hover:text-sky-600 mb-1">${phrase.category}</span>
                  <span class="font-medium text-slate-700 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-white">${phrase.text}</span>
                </button>
            `).join('');
        }

        window.setQuickPhrase = (text, id) => {
            textInput.value = text;
            translateBtn.disabled = false;
            clearBtn.classList.remove('hidden');

            // if we have translation locally, use it to save API call
            const phrase = quickPhrases.find(p => p.id == id);
            const target = langTo.value;
            if (phrase && phrase.translations && phrase.translations[target]) {
                outputText.innerText = phrase.translations[target];
                outputText.classList.remove('hidden');
                outputPlaceholder.classList.add('hidden');
                outputActions.classList.remove('hidden');
            } else {
                handleTranslate();
            }
        };

        renderQuickPhrases();
    </script>
}

<!-- Language list updated and error handling improved -->
