@model TravelDost_MVC.Models.AuthModel

@{
    // ViewData["Title"] = "Login";
    // Layout = "_Layout";
}

<div class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-md">

        <a href="/" class="mb-6 flex items-center gap-2 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
            @* <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg> *@
            Back to Home
        </a>

        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <div class="mb-4 rounded-lg bg-red-50 border px-4 py-3 text-sm text-red-700">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }


        <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 shadow-xl dark:shadow-slate-900/50">
            <div class="flex flex-col items-center gap-2">
                <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Welcome Back</h1>
                <p class="text-slate-600 dark:text-slate-400">Sign in to continue your journey</p>
            </div>

            <form method="post" class="mt-8 flex flex-col gap-5">

                <div class="flex flex-col gap-2">
                    <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Email Address</label>
                    <div class="relative">
                        <input type="email" name="Email"
                               value="@Model?.Email"
                               placeholder="you@example.com" required
                               class="w-full rounded-lg border py-3 pl-10 pr-4" />
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Password</label>
                    <div class="relative">
                        <input type="password" name="Password"
                               placeholder="••••••••" required
                               class="w-full rounded-lg border py-3 pl-10 pr-4" />
                    </div>
                </div>

                <button type="submit"
                        class="mt-2 flex w-full items-center justify-center gap-2 rounded-lg bg-sky-600 hover:bg-sky-700 py-3 font-medium text-white">
                    Sign In
                </button>
            </form>

        </div>
    </div>
</div>